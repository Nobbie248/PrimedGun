<!-- The About tab: version and build details, tips for playing on Quest, links and credits.
     Links are buttons rather than inline hyperlinks because a controller pointer hits a full-width
     button far more easily than a few words of text. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <TextView
            style="@style/PrimedGunSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/primedgun_section_about" />

        <TextView
            style="@style/PrimedGunLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/primedgun_about_summary" />

        <TextView
            android:id="@+id/about_version"
            style="@style/PrimedGunLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            tools:text="Version: v1.2.0" />

        <TextView
            android:id="@+id/about_build"
            style="@style/PrimedGunMutedLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="Build: quest release, revision 3863f3c7a1" />

        <TextView
            style="@style/PrimedGunMutedLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/primedgun_about_game" />

        <TextView
            android:id="@+id/about_user_folder"
            style="@style/PrimedGunMutedLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            tools:text="User folder: /storage/emulated/0/Android/data/org.dolphinemu.dolphinemu.quest/files"
            tools:visibility="visible" />

        <TextView
            style="@style/PrimedGunMutedLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/primedgun_about_license" />

        <TextView
            style="@style/PrimedGunSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/primedgun_section_useful_info" />

        <TextView
            style="@style/PrimedGunLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/primedgun_about_useful_info_text" />

        <TextView
            style="@style/PrimedGunSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/primedgun_section_links" />

        <Button
            android:id="@+id/about_github"
            style="@style/PrimedGunButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/primedgun_about_github" />

        <Button
            android:id="@+id/about_discord"
            style="@style/PrimedGunButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/primedgun_about_discord" />

        <TextView
            style="@style/PrimedGunMutedLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/primedgun_about_discord_note" />

        <TextView
            style="@style/PrimedGunSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/primedgun_section_credits" />

        <TextView
            style="@style/PrimedGunLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/primedgun_about_credits_text" />
    </LinearLayout>
</ScrollView>
