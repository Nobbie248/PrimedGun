<!-- The exclusive radio pairs from the Qt window (hand, movement stick, movement direction). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/primedgun_toggle2_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/primedgun_text"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Movement direction"
        tools:visibility="visible" />

    <RadioGroup
        android:id="@+id/primedgun_toggle2_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/primedgun_toggle2_a"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:textColor="@color/primedgun_text"
            android:textSize="14sp"
            tools:text="Controller direction" />

        <RadioButton
            android:id="@+id/primedgun_toggle2_b"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:textColor="@color/primedgun_text"
            android:textSize="14sp"
            tools:text="HMD direction" />
    </RadioGroup>
</LinearLayout>
