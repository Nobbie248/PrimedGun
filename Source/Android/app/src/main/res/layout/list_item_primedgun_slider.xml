<!-- The Qt window puts label, slider, spin box and the -/+ steppers on one row. At panel width
     that row does not fit, so the label and value take the first line and the slider keeps the
     steppers beside it on the second. Every control from the desktop row is still present. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/primedgun_slider_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/primedgun_text"
            android:textSize="14sp"
            tools:text="Movement speed" />

        <TextView
            android:id="@+id/primedgun_slider_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:minWidth="64dp"
            android:textAlignment="textEnd"
            android:textColor="@color/primedgun_accent_text"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="14.00" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/primedgun_slider_minus"
            style="@style/PrimedGunButton.Small"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/primedgun_decrease"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/primedgun_minus"
            android:textSize="18sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/primedgun_slider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/primedgun_slider" />

        <Button
            android:id="@+id/primedgun_slider_plus"
            style="@style/PrimedGunButton.Small"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/primedgun_increase"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/primedgun_plus"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
